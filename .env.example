# SUPABASE POSTGRESQL & AUTH (Phase 3)
# Retrieve from: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# BACKEND SERVER CONFIGURATION
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# EXTERNAL REAL-DATA APIS (Phase 4, 5, 6)
# Google Gemini API Key for Crop Doctor Vision & Krishi Mitra Assistant:
# Get key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Data.gov.in API Key for Agmarknet Mandi Rates:
# Get key from: https://data.gov.in
DATA_GOV_IN_API_KEY=your_data_gov_in_api_key_here