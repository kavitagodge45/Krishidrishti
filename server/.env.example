# ==============================================================================
# KRISHIDRISHTI SERVER — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to server/.env and fill in with genuine credentials.
# Never commit actual keys or secrets to version control.
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Supabase Authentication & PostgreSQL Database
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini AI Integration (Crop Doctor Vision & Krishi Mitra Assistant)
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Official Ministry of Agriculture Agmarknet Portal via Data.gov.in
# Obtain key from: https://data.gov.in
DATA_GOV_API_KEY=
